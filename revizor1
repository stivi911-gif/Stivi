        if (!SCRIPT_URL || SCRIPT_URL.includes("УСТАНОВІТЬ_СЮДИ")) return;
        fetch(SCRIPT_URL)
            .then(res => res.json())
            .then(data => {
                if (data && data.tasks && data.tasks.length > 0) {
                    let activeBefore = localDB.tasks.filter(t => t.status === "виконується").length;
                    localDB = data;
                    let activeAfter = localDB.tasks.filter(t => t.status === "виконується").length;
                    if (!isFirstLoad && activeAfter > activeBefore) { showNotify(); }
                    isFirstLoad = false;
                    forceUpdate();
                }
            })
            .catch(e => console.log("Помилка синхронізації:", e));
    }

    function executeAction(p) {
        if (p.action === "updateMeta") {
            localDB.shop = p.shop; localDB.headOfCommission = p.head;
        } else if (p.action === "assignZone") {
            let t = localDB.tasks.find(x => x.zone === p.zone);
            if(t) t.person = p.person || "Не призначено";
        } else if (p.action === "activateAll") {
            localDB.tasks.forEach(x => { if(x.person !== "Не призначено" && x.status !== "виконано") x.status = "виконується"; });
        } else if (p.action === "resetAll") {
            localDB.tasks.forEach(t => { t.status = ""; });
        } else if (p.action === "markDone") {
            let t = localDB.tasks.find(x => x.zone === p.zone); if(t) t.status = "виконано";
        } else if (p.action === "undoDone") {
            let t = localDB.tasks.find(x => x.zone === p.zone); if(t) t.status = "виконується";
        }
        forceUpdate();
        saveDataToServer();
    }

    function forceUpdate() {
        document.getElementById('display-shop').innerText = '№' + localDB.shop;
        document.getElementById('display-head').innerText = localDB.headOfCommission ? '👤 Голова РК: ' + localDB.headOfCommission : '';

        // 🛠 СИНХРОНІЗАЦІЯ ІНПУТІВ В АДМІНЦІ
        if (document.getElementById('inp-shop') && document.activeElement !== document.getElementById('inp-shop')) {
            document.getElementById('inp-shop').value = localDB.shop === "—" ? "" : localDB.shop;
        }
        if (document.getElementById('inp-head') && document.activeElement !== document.getElementById('inp-head')) {
            document.getElementById('inp-head').value = localDB.headOfCommission || '';
        }

        let activeCount = localDB.tasks.filter(t => t.status === "виконується").length;
        let doneCount = localDB.tasks.filter(t => t.status === "виконано").length;
        document.getElementById('count-active').innerText = activeCount;
        document.getElementById('count-done').innerText = doneCount + '/' + localDB.tasks.length;

        const runningTasks = localDB.tasks.filter(t => t.status === "виконується" || t.status === "виконано");
        renderRevisorList('sklad-list', runningTasks.filter(t => t.type === "СКЛАД"));
        renderZalList('zal-list', runningTasks.filter(t => t.type === "ЗАЛ"));
        renderAdminList(localDB.tasks);
    }

    function showNotify() {
        document.getElementById('alert').style.display = 'block';
        if (audioCtx.state === 'suspended') { audioCtx.resume().then(() => { playLoudNotification(); }); } 
        else { playLoudNotification(); }
        if (navigator.vibrate) navigator.vibrate([200, 100, 200]);
        setTimeout(() => { document.getElementById('alert').style.display = 'none'; }, 15000);
    }

    function renderRevisorList(id, list) {
        const container = document.getElementById(id);
        if (list.length === 0) { container.innerHTML = '<div style="padding:25px;color:#555;text-align:center;font-size:12px;font-weight:bold;">ЗАДАЧІ ВІДСУТНІ</div>'; return; }
        const grouped = list.reduce((acc, t) => { if (!acc[t.person]) acc[t.person] = []; acc[t.person].push(t); return acc; }, {});
        let html = '';
        for (const person in grouped) {
            html += `<div class="person-group">👤 ${person}</div>`;
            html += grouped[person].map(t => `
                <div class="card">
                    <div class="z-name">${t.zone}</div>
                    <div>
                        ${t.status === 'виконується' ? 
                            `<button class="action-btn btn-done" onclick="taskAction('markDone', '${t.zone}', 'Завершити зону?')">Завершити</button>` : 
                            `<div style="display:flex;align-items:center;"><span class="status-done-text">✓</span><button class="action-btn btn-undo" onclick="taskAction('undoDone', '${t.zone}', 'Повернути в роботу?')">↩</button></div>`
                        }
                    </div>
                </div>
            `).join('');
        }
        container.innerHTML = html;
    }

    function renderZalList(id, list) { renderRevisorList(id, list); }

    function renderAdminList(tasks) {
        const genRows = (filtered) => filtered.map(t => {
            let options = `<option value="">Не призначено</option>` + localDB.revisors.map(r => `<option value="${r}" ${t.person === r ? 'selected' : ''}>${r}</option>`).join('');
            let badge = t.status === 'виконується' ? ' ⏳' : (t.status === 'виконано' ? ' ✅' : '');
            return `<div class="adm-zone-row"><div class="adm-zone-name">${t.zone}${badge}</div><select class="adm-select" onchange="changeZoneAssign('${t.zone}', this.value)">${options}</select></div>`;
        }).join('');
        document.getElementById('admin-sklad-list').innerHTML = genRows(tasks.filter(t => t.type === "СКЛАД"));
        document.getElementById('admin-zal-list').innerHTML = genRows(tasks.filter(t => t.type === "ЗАЛ"));
    }

    function changeZoneAssign(z, personName) { executeAction({action: 'assignZone', zone: z, person: personName}); }
    
    const headSelect = document.getElementById('inp-head');
    localDB.revisors.forEach(r => { let opt = new Option(r, r); headSelect.add(opt); });

    function saveMeta() {
        executeAction({action: 'updateMeta', shop: document.getElementById('inp-shop').value, head: document.getElementById('inp-head').value});
        alert("✅ Дані збережено!");
    }

    function startNewRevision() {
        if (confirm("🚨 Розпочати нову ревізію? Всі дані будуть видалені!")) {
            localDB.shop = "—"; localDB.headOfCommission = "";
            document.getElementById('inp-shop').value = ''; document.getElementById('inp-head').value = '';
            localDB.tasks.forEach(t => { t.person = "Не призначено"; t.status = ""; });
            isAdminAuthenticated = false;
            document.getElementById('admin-auth-container').style.display = 'block';
            document.getElementById('admin-actual-content').style.display = 'none';
            executeAction({action: 'none'});
        }
    }

    function taskAction(actionName, zoneName, msg) { if(confirm(msg)) { executeAction({action: actionName, zone: zoneName}); } }
    function adminAction(actionName, confirmMsg) { if (confirm(confirmMsg)) { executeAction({action: actionName}); } }

    function renderCodes(list) { document.getElementById('codes-container').innerHTML = list.map(item => `<div class="code-row"><span class="code-desc"><b>${item.name}</b></span><span class="code-num">${item.code}</span></div>`).join(''); }
    function filterCodes() { let q = document.getElementById('search-bar').value.toLowerCase(); renderCodes(cheatCodes.filter(i => i.code.includes(q) || i.name.toLowerCase().includes(q))); }

    function setBagType(type) {
        selectedBagType = type;
        document.getElementById('btn-type-no').classList.toggle('active-type', type === 'no-handles');
        document.getElementById('btn-type-with').classList.toggle('active-type', type === 'handles');
        document.getElementById('lbl-vtl').innerText = type === 'no-handles' ? '42 г' : '36 г';
        document.getElementById('lbl-pkt').innerText = type === 'no-handles' ? '2.2 г' : '3.2 г';
        calcBagsTotal();
    }
    function calcBagsTotal() {
        let w = parseFloat(document.getElementById('bag-total-weight').value) || 0;
        let v = parseInt(document.getElementById('bag-vtl-qty').value) || 0;
        let vtl = selectedBagType === 'no-handles' ? 42 : 36;
        let pkt = selectedBagType === 'no-handles' ? 2.2 : 3.2;
        let res = Math.floor((w - (v * vtl)) / pkt);
        document.getElementById('bag-calc-result').innerText = res > 0 ? res : 0;
    }
    function clearBagsCalc() { document.getElementById('bag-total-weight').value = ''; document.getElementById('bag-vtl-qty').value = '1'; document.getElementById('bag-calc-result').innerText = '0'; }

    renderCodes(cheatCodes);
    forceUpdate();
    loadDataFromServer();
    setInterval(loadDataFromServer, 5000); 
</script>
</body>
</html>
